/*
 * secret.h - Configuration file for ESP32 Smart Pet Feeder
 * 
 * IMPORTANT: Do not commit this file to public repositories!
 * Add this file to .gitignore
 */

#ifndef SECRET_H
#define SECRET_H

// ================================================================
//                    WiFi CREDENTIALS
// ================================================================
#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASS "YOUR_WIFI_PASSWORD"

// ================================================================
//                    MQTT CONFIGURATION (Google Cloud IoT)
// ================================================================
#define MQTT_SERVER "YOUR_MQTT_BROKER_ADDRESS"  // e.g., "mqtt.googleapis.com"
#define MQTT_PORT 8883
#define MQTT_USER "YOUR_MQTT_USERNAME"
#define MQTT_PASS "YOUR_MQTT_PASSWORD"

#define DEVICE_ID "feeder_001"
#define TELEMETRY_TOPIC "/devices/feeder_001/events"
#define EVENT_TOPIC "/devices/feeder_001/events/feeding"
#define COMMAND_TOPIC "/devices/feeder_001/commands"

// ================================================================
//                    FIREBASE CONFIGURATION
// ================================================================
// Get these from Firebase Console > Project Settings

#define FIREBASE_API_KEY "YOUR_FIREBASE_API_KEY"
#define FIREBASE_PROJECT_ID "YOUR_FIREBASE_PROJECT_ID"
#define FIREBASE_DATABASE_URL "https://YOUR_PROJECT_ID.firebaseio.com"

// Create a device user in Firebase Authentication
// Go to Firebase Console > Authentication > Users > Add User
// Example: device@yourproject.com with a strong password
#define FIREBASE_USER_EMAIL "device@yourproject.com"
#define FIREBASE_USER_PASSWORD "YOUR_DEVICE_USER_PASSWORD"

#endif // SECRET_H
